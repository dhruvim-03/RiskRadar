# ==============================================================================
# Fraud Detection System - Environment Configuration Template
# Copy this file to .env and replace placeholder values for your deployment
# ==============================================================================

# Database Credentials
POSTGRES_DB=fraud_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here
DB_URL=jdbc:postgresql://localhost:5432/fraud_db
DB_USERNAME=postgres
DB_PASSWORD=your_secure_postgres_password_here

# JWT Authentication
# Base64-encoded 256-bit key for HMAC-SHA256 signing
JWT_SECRET=dGhpcy1pcy1hLXNlY3VyZS0yNTYtYml0LXNlY3JldC1rZXktZm9yLWp3dC10b2tlbi1nZW5lcmF0aW9uLTEyMzQ1Njc4OTA=
JWT_EXPIRATION_MS=3600000

# Backend Server & CORS
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Python ML Microservice Configuration
ML_SERVICE_BASE_URL=http://localhost:8000
ML_SERVICE_INTERNAL_KEY=your_shared_internal_api_secret_key
PORT=8000
MODEL_DIR=./models
ACTIVE_MODEL_VERSION=v1
INTERNAL_API_KEY=your_shared_internal_api_secret_key

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8080/api

# Drift Monitoring Scheduled Job Configuration
DRIFT_CRON=0 0 */4 * * *
DRIFT_PSI_THRESHOLD=0.20
DRIFT_WINDOW_DAYS=7
